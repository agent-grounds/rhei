{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rhei.accounting.usage.v1",
  "title": "Rhei normalized accounting usage event v1",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": true,
      "required": ["schema", "usage"],
      "properties": {
        "schema": { "const": "rhei.accounting.usage.v1" },
        "status": false,
        "diagnostic": false,
        "usage": {
          "type": "object",
          "additionalProperties": true,
          "minProperties": 1,
          "properties": {
            "total_tokens": { "type": "integer", "minimum": 0 },
            "input_tokens": {
              "type": "integer",
              "minimum": 0,
              "description": "Every input token counted for this turn, cached reads and cache writes included. A capture event states its dimensions in this convention and is never converted again."
            },
            "cached_input_tokens": {
              "type": "integer",
              "minimum": 0,
              "description": "The part of input_tokens served from cache, not a figure beside it."
            },
            "cache_write_input_tokens": {
              "type": "integer",
              "minimum": 0,
              "description": "The part of input_tokens written into cache, not a figure beside it."
            },
            "output_tokens": { "type": "integer", "minimum": 0 },
            "cached_output_tokens": { "type": "integer", "minimum": 0 },
            "output_cache_write": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": true,
      "required": ["schema", "status"],
      "properties": {
        "schema": { "const": "rhei.accounting.usage.v1" },
        "status": { "const": "extractor-failed" },
        "diagnostic": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "pattern": "^[^\\r\\n]+$"
        },
        "usage": false
      }
    }
  ]
}
