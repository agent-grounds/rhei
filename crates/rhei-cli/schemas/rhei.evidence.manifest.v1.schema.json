{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rhei.evidence.manifest.v1",
  "title": "Rhei run evidence manifest v1",
  "description": "Written once when a run ends, or by the next run for one killed outright; its digest is the sha256 of the file. FS-rhei-evidence.9",
  "type": "object",
  "required": [
    "schema", "run_id", "status", "exit_code", "started_at", "ended_at", "finalized_by",
    "rhei_build", "checkout_head_at_start", "invocations", "files", "accounting", "snapshots"
  ],
  "properties": {
    "schema": { "const": "rhei.evidence.manifest.v1" },
    "run_id": { "type": "string", "minLength": 1 },
    "status": { "enum": ["finished", "failed", "interrupted", "incomplete"] },
    "exit_code": { "type": ["integer", "null"] },
    "started_at": { "type": "string", "minLength": 1 },
    "ended_at": { "type": ["string", "null"] },
    "finalized_by": { "type": ["string", "null"] },
    "rhei_build": { "type": "object" },
    "checkout_head_at_start": { "type": ["object", "null"] },
    "invocations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "id", "key", "completed"],
        "properties": {
          "kind": { "enum": ["agent", "program", "callback"] },
          "id": { "type": "string", "minLength": 1 },
          "key": { "type": "string", "minLength": 1 },
          "completed": { "type": "boolean" }
        }
      }
    },
    "files": { "type": "array", "items": { "$ref": "#/$defs/file" } },
    "accounting": { "type": "array", "items": { "$ref": "#/$defs/file" } },
    "snapshots": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["ref", "transcript_sha256"],
        "properties": { "transcript_sha256": { "$ref": "#/$defs/sha256" } }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "file": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1, "pattern": "^[^/\\\\][^\\\\]*$" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
