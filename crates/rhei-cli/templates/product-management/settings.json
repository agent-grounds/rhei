{
  "defaults": {
    "agent_timeout": "30m"
  },
  "agents": {
    "codex": {
      "command": [
        "codex",
        "exec"
      ],
      "model_flag": "--model",
      "stdin_prompt": true,
      "mcp_flag": "--mcp",
      "writable_roots": {
        "path_flag": "--add-dir"
      },
      "modes": {
        "yolo": [
          "--sandbox",
          "danger-full-access",
          "--skip-git-repo-check",
          "-c",
          "approval_policy=\"never\""
        ],
        "workspace": [
          "--sandbox",
          "workspace-write",
          "--skip-git-repo-check",
          "-c",
          "approval_policy=\"never\"",
          "-c",
          "sandbox_workspace_write.network_access=true"
        ],
        "medium": [
          "--sandbox",
          "workspace-write",
          "--skip-git-repo-check",
          "-c",
          "approval_policy=\"never\"",
          "-c",
          "sandbox_workspace_write.network_access=true",
          "-c",
          "model_reasoning_effort=\"medium\""
        ],
        "high": [
          "--sandbox",
          "workspace-write",
          "--skip-git-repo-check",
          "-c",
          "approval_policy=\"never\"",
          "-c",
          "sandbox_workspace_write.network_access=true",
          "-c",
          "model_reasoning_effort=\"high\""
        ],
        "xhigh": [
          "--sandbox",
          "workspace-write",
          "--skip-git-repo-check",
          "-c",
          "approval_policy=\"never\"",
          "-c",
          "sandbox_workspace_write.network_access=true",
          "-c",
          "model_reasoning_effort=\"xhigh\""
        ]
      }
    }
  }
}
